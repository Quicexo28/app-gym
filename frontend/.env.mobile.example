# Copia este archivo a frontend/.env.mobile y completa los valores.
# `npm run build:mobile` compila con --mode mobile y Vite carga .env.mobile.

# URL publica del backend (HTTPS obligatorio). Sin esto la app movil no tiene red.
VITE_API_BASE_URL=https://api.tu-dominio.com

# OAuth client ID tipo "Web application" del proyecto de Google Cloud.
# El mismo que usa el backend (GOOGLE_CLIENT_ID) y la PWA.
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Solo iOS: OAuth client ID tipo "iOS" (bundle com.santiagoquiceno.alzo). Sin esto el
# boton de Google no aparece en iOS. El backend debe tenerlo en GOOGLE_IOS_CLIENT_ID.
VITE_GOOGLE_IOS_CLIENT_ID=yyyyyyyy.apps.googleusercontent.com

# Responsable y correo de contacto de las paginas legales (/legal/*).
VITE_LEGAL_CONTACT_EMAIL=contacto@tu-dominio.com
VITE_LEGAL_OWNER_NAME=Nombre del responsable

# Opcionales
VITE_ENABLE_OFFLINE_VOICE_CAPTURE=true
VITE_ENABLE_GUEST_LOGIN=false
