# API
DATABASE_URL=postgresql+psycopg://coach:change-me@db:5432/coach_ai
# OBLIGATORIO: la API no arranca en prod con el valor por defecto.
JWT_SECRET=change-me-in-production
APP_NAME=Coach AI Engineer
LOG_LEVEL=INFO
ENV=prod
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Client ID OAuth tipo "iOS" (Google Cloud): el idToken de la app iOS trae este `aud`.
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
# Sign in with Apple: `aud` aceptados del identity token (JSON). El bundle ID va primero.
APPLE_CLIENT_IDS=["com.santiagoquiceno.alzo"]
# Opcionales pero necesarios para revocar el token de Apple al borrar la cuenta
# (requisito de App Review). Apple Developer > Keys > key con "Sign in with Apple".
# APPLE_PRIVATE_KEY = contenido del .p8 en una linea, saltos de linea como \n.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
ACCESS_TOKEN_MIN=1440
# Stripe: suscripcion del plan coach + asiento extra (ver docs/publicacion-android.md o Stripe Dashboard)
STRIPE_SECRET_KEY=sk_live_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me
STRIPE_PRICE_COACH_PLAN=price_change-me
STRIPE_PRICE_EXTRA_SEAT=price_change-me
COACH_INCLUDED_SEATS=15
PUBLIC_WEB_URL=https://tu-dominio.com
# Origenes CORS extra (JSON). Con el proxy nginx (/api same-origin) normalmente no hace falta.
# CORS_ORIGINS=["https://tu-dominio.com"]

# Optional overrides for docker-compose.prod.yml
POSTGRES_DB=coach_ai
POSTGRES_USER=coach
POSTGRES_PASSWORD=change-me
API_PORT=8000
WEB_PORT=8080
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
VITE_ENABLE_GUEST_LOGIN=false
VITE_ENABLE_OFFLINE_VOICE_CAPTURE=false
# Responsable y correo de contacto que muestran /legal/privacidad, /legal/terminos y
# /legal/eliminar-cuenta (las URLs que se registran en App Store y Google Play).
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_OWNER_NAME=
